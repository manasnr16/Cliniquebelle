# Copy to .env.local for local overrides. Never commit real secrets.

# Search-engine indexing. Leave unset/false for preview and staging.
# Set to "true" ONLY on the approved production deployment.
ALLOW_INDEXING=false

# Google Tag Manager container. Leave empty on preview so staging visits do
# not pollute live analytics. The live WordPress site currently uses
# GTM-MFN4TP37 - confirm with the SEO consultant before enabling it here.
NEXT_PUBLIC_GTM_ID=
